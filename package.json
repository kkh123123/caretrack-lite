{
  "name": "caretrack-lite",
  "version": "0.1.0",
  "private": true,
  "description": "A simplified care-tracking app for learning Express, EJS, Knex and PostgreSQL",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "node --watch app.js",
    "db:migrate": "knex migrate:latest",
    "db:rollback": "knex migrate:rollback",
    "db:seed": "knex seed:run"
  },
  "dependencies": {
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "knex": "^3.1.0",
    "pg": "^8.12.0"
  }
}
